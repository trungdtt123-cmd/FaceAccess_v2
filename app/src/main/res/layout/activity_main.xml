                                android:layout_weight="1"
                                android:text="MIỆNG : --"
                                android:textColor="#36564B"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

