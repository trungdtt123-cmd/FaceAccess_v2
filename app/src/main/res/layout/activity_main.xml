<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_man_hinh"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FaceAccess"
                        android:textColor="@color/chu_chinh"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Điều khiển Android bằng khuôn mặt"
                        android:textColor="@color/chu_phu"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/nen_che_do_dang_chon"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="AI"
                    android:textColor="@color/xanh_chinh"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Trạng thái -->
            <LinearLayout
                android:id="@+id/khungTrangThaiHeThong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/nen_the"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trạng thái hệ thống"
                        android:textColor="@color/chu_chinh"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTrangThaiHeThong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="● Chưa theo dõi"
                        android:textColor="@color/do_trang_thai"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnBatDauTheoDoi"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/xanh_chinh"
                    android:text="BẮT ĐẦU THEO DÕI"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Camera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Camera trực tiếp"
                    android:textColor="@color/chu_chinh"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Camera trước"
                    android:textColor="@color/chu_phu"
                    android:textSize="12sp" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/khungCameraContainer"
                android:layout_width="match_parent"
                android:layout_height="205dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/nen_the">

                <androidx.camera.view.PreviewView
                    android:id="@+id/khungCamera"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtTrangThaiCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="CAMERA&#10;Chưa khởi động"
                    android:textColor="@color/chu_phu"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Hiệu chỉnh -->
            <LinearLayout
                android:id="@+id/khungHieuChinh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/nen_the"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <!-- Màn chuẩn bị -->
                <LinearLayout
                    android:id="@+id/khungChuanBiHieuChinh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Hiệu chỉnh cá nhân"
                        android:textColor="@color/chu_chinh"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="FaceAccess sẽ ghi nhận 9 cử chỉ để điều chỉnh độ nhạy phù hợp với bạn."
                        android:textColor="@color/chu_phu"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/nen_che_do_thuong"
                        android:padding="12dp"
                        android:text="Chuẩn bị: giữ điện thoại ổn định, khuôn mặt đủ sáng và nhìn rõ vào camera. Chỉ bắt đầu khi bạn đã sẵn sàng."
                        android:textColor="@color/chu_chinh"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnBatDauHieuChinh"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/xanh_chinh"
                        android:text="BẮT ĐẦU HIỆU CHỈNH"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Nếu camera chưa bật, hệ thống sẽ tự khởi động camera sau khi bạn nhấn Bắt đầu."
                        android:textColor="@color/chu_phu"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Tiến trình hiệu chỉnh -->
                <LinearLayout
                    android:id="@+id/khungTienTrinhHieuChinh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtBuocHieuChinh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Bước 1 / 9"
                        android:textColor="@color/xanh_chinh"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDongTacHieuChinh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="NHÌN THẲNG"
                        android:textColor="@color/chu_chinh"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHuongDanHieuChinh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Nhìn thẳng vào camera và giữ đầu tự nhiên"
                        android:textColor="@color/chu_phu"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtDemNguocHieuChinh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Chuẩn bị..."
                        android:textColor="@color/chu_chinh"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressHieuChinh"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/txtTienDoHieuChinh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="0%"
                        android:textColor="@color/chu_chinh"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPhanHoiHieuChinh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Giữ khuôn mặt trong khung hình"
                        android:textColor="@color/chu_phu"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnHuyHieuChinh"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="HỦY HIỆU CHỈNH"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Nội dung chính -->
            <LinearLayout
                android:id="@+id/noiDungChinh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Chế độ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/nen_the"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chế độ hiện tại"
                            android:textColor="@color/chu_phu"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtCheDoHienTai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="ĐIỀU HƯỚNG"
                            android:textColor="@color/xanh_chinh"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nghiêng phải để đổi"
                        android:textColor="@color/chu_phu"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- 4 chế độ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Chế độ điều khiển"
                    android:textColor="@color/chu_chinh"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cardDieuHuong"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/nen_che_do_dang_chon"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="ĐIỀU HƯỚNG"
                        android:textColor="@color/xanh_chinh"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/cardMedia"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/nen_che_do_thuong"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="MEDIA"
                        android:textColor="@color/chu_chinh"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cardHoTro"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/nen_che_do_thuong"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="HỖ TRỢ"
                        android:textColor="@color/chu_chinh"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/cardConTro"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/nen_che_do_thuong"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="CON TRỎ"
                        android:textColor="@color/chu_chinh"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Nhận diện -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Nhận diện trực tiếp"
                    android:textColor="@color/chu_chinh"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/nen_the"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtRoll"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ROLL : --"
                            android:textColor="@color/chu_chinh"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtYaw"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="YAW : --"
                            android:textColor="@color/chu_chinh"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtPitch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PITCH : --"
                            android:textColor="@color/chu_chinh"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtTrangThaiMat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="MẮT : --"
                            android:textColor="@color/chu_chinh"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtTrangThaiMieng"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="MIỆNG : --"
                        android:textColor="@color/chu_chinh"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Menu dưới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/nen_the"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/navTrangChu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nen_che_do_dang_chon"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⌂&#10;TRANG CHỦ"
            android:textColor="@color/xanh_chinh"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/navHieuChinh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nen_che_do_thuong"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="◎&#10;HIỆU CHỈNH"
            android:textColor="@color/chu_phu"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/navCaiDat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nen_che_do_thuong"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⚙&#10;CÀI ĐẶT"
            android:textColor="@color/chu_phu"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
