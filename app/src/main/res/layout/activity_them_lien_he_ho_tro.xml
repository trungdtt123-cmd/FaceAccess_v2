<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_man_hinh"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuayLaiThemLienHe"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="←"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Thêm liên hệ hỗ trợ"
                android:textColor="@color/chu_chinh"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Tên"
            android:textColor="@color/chu_chinh"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTenLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/nen_the"
            android:hint="Nhập tên liên hệ"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/chu_chinh"
            android:textColorHint="@color/chu_phu" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Số điện thoại"
            android:textColor="@color/chu_chinh"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtSoDienThoaiLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/nen_the"
            android:hint="Nhập số điện thoại"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/chu_chinh"
            android:textColorHint="@color/chu_phu" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cho phép 9–15 chữ số, có thể bắt đầu bằng +"
            android:textColor="@color/chu_phu"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mô tả"
            android:textColor="@color/chu_chinh"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtMoTaLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/nen_the"
            android:gravity="top|start"
            android:hint="Nhập mô tả cho liên hệ"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="16dp"
            android:textColor="@color/chu_chinh"
            android:textColorHint="@color/chu_phu" />

        <Button
            android:id="@+id/btnLuuLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/xanh_chinh"
            android:text="LƯU LIÊN HỆ"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
