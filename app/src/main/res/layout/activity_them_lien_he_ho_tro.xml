<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FBF8"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuayLaiThemLienHe"
                android:layout_width="34dp"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="&#8249;"
                android:textAllCaps="false"
                android:textColor="#173D33"
                android:textSize="34sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Thêm liên hệ hỗ trợ"
                android:textColor="#103A2F"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="FaceAccess"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_faceaccess_logo" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="12dp"
            android:text="Nhập thông tin người bạn muốn thêm vào danh sách hỗ trợ."
            android:textColor="#71847C"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/fa_support_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thông tin liên hệ"
                android:textColor="#173D33"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tên"
                android:textColor="#36564B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTenLienHeHoTro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fa_support_input"
                android:hint="Nhập tên liên hệ"
                android:inputType="textPersonName"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#173D33"
                android:textColorHint="#8A9A94"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Số điện thoại"
                android:textColor="#36564B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtSoDienThoaiLienHeHoTro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fa_support_input"
                android:drawableStart="@drawable/ic_support_phone"
                android:drawablePadding="9dp"
                android:hint="Nhập số điện thoại"
                android:inputType="phone"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#173D33"
                android:textColorHint="#8A9A94"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="6dp"
                android:text="Cho phép 9–15 chữ số, có thể bắt đầu bằng +"
                android:textColor="#7D8F88"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mô tả"
                android:textColor="#36564B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtMoTaLienHeHoTro"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fa_support_input"
                android:gravity="top|start"
                android:hint="Ví dụ: Người thân, giáo viên, người hỗ trợ..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="15dp"
                android:textColor="#173D33"
                android:textColorHint="#8A9A94"
                android:textSize="15sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnLuuLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/fa_support_button_primary"
            android:backgroundTint="@null"
            android:gravity="center"
            android:minHeight="0dp"
            android:text="Lưu liên hệ"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
