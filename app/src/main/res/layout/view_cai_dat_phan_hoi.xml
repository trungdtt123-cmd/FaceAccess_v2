<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/fa_settings_card" android:orientation="vertical" tools:ignore="HardcodedText" android:elevation="2dp">
    <LinearLayout android:id="@+id/mucPhanHoi" android:layout_width="match_parent" android:layout_height="78dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="14dp">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="" android:src="@drawable/ic_settings_speed" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tốc độ phản hồi" android:textColor="@color/chu_chinh" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:text="Thời gian giữ và khoảng chờ" android:textColor="@color/chu_phu" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/muiTenPhanHoi" android:layout_width="30dp" android:layout_height="42dp" android:gravity="center" android:text="›" android:textColor="#2A9D75" android:textSize="27sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/noiDungPhanHoi" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="0dp" android:paddingEnd="16dp" android:paddingBottom="16dp" android:visibility="gone">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="10dp" android:background="#E7EFEB" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Điều chỉnh thời gian giữ và khoảng chờ. Giá trị thấp cho phản hồi nhanh hơn nhưng có thể dễ kích hoạt nhầm." android:textColor="@color/chu_phu" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quay / ngẩng" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtThoiGianHuongDau" android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="end" android:text="0 ms" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekThoiGianHuongDau" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nghiêng đầu" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtThoiGianNghiengDau" android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="end" android:text="0 ms" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekThoiGianNghiengDau" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nhắm mắt" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtThoiGianNhamMat" android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="end" android:text="0 ms" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekThoiGianNhamMat" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Há miệng" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtThoiGianMoMieng" android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="end" android:text="0 ms" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekThoiGianMoMieng" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Há miệng 2 lần" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtKhoangMoMiengHaiLan" android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="end" android:text="0 ms" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekKhoangMoMiengHaiLan" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <Button android:id="@+id/btnDatLaiPhanHoi" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="ĐẶT LẠI TỐC ĐỘ PHẢN HỒI" android:textColor="#31574B" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/fa_settings_button_soft" android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
