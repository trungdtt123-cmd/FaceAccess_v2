<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/khungHieuChinh"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/hd_hero_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="18dp"
    android:visibility="gone">

    <!-- Chuẩn bị hiệu chỉnh -->
    <LinearLayout
        android:id="@+id/khungChuanBiHieuChinh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="visible">

        <FrameLayout
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/hd_circle_mint">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="Biểu tượng hiệu chỉnh khuôn mặt"
                android:src="@drawable/ic_calibration_target" />

        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Hiệu chỉnh cá nhân"
            android:textColor="#103A2F"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Tối ưu độ nhạy nhận diện phù hợp với khuôn mặt của bạn."
            android:textColor="#71847C"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/hd_circle_blue"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="9 bước  •  khoảng 1 phút"
            android:textColor="#397E9D"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/hd_card_mint"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trước khi bắt đầu"
                android:textColor="#123C30"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/hd_circle_mint">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="Giữ điện thoại ổn định"
                        android:src="@drawable/ic_calibration_phone" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Giữ điện thoại ổn định"
                    android:textColor="#526A61"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/hd_circle_mint">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="Đảm bảo khuôn mặt đủ sáng"
                        android:src="@drawable/ic_calibration_light" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Đảm bảo khuôn mặt đủ sáng"
                    android:textColor="#526A61"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/hd_circle_blue">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="Nhìn rõ vào camera"
                        android:src="@drawable/ic_calibration_camera" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Đặt khuôn mặt rõ trong khung camera"
                    android:textColor="#526A61"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnBatDauHieuChinh"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/fa_calibration_button"
            android:backgroundTint="@null"
            android:elevation="0dp"
            android:text="BẮT ĐẦU HIỆU CHỈNH"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:text="Camera sẽ tự khởi động khi cần."
            android:textColor="#82918B"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Tiến trình hiệu chỉnh -->
    <LinearLayout
        android:id="@+id/khungTienTrinhHieuChinh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/hd_circle_mint">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:contentDescription="Hiệu chỉnh đang chạy"
                android:src="@drawable/ic_calibration_target" />

        </FrameLayout>

        <TextView
            android:id="@+id/txtBuocHieuChinh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/hd_circle_blue"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="Bước 1 / 9"
            android:textColor="#397E9D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDongTacHieuChinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="NHÌN THẲNG"
            android:textColor="#103A2F"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHuongDanHieuChinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Nhìn thẳng vào camera và giữ đầu tự nhiên"
            android:textColor="#687C74"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtDemNguocHieuChinh"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/hd_circle_mint"
            android:gravity="center"
            android:text="3"
            android:textColor="#218A68"
            android:textSize="31sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressHieuChinh"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="18dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/fa_progress_track" />

        <TextView
            android:id="@+id/txtTienDoHieuChinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="0%"
            android:textColor="#5D7169"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPhanHoiHieuChinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="@drawable/hd_action_strip"
            android:gravity="center"
            android:padding="13dp"
            android:text="Giữ khuôn mặt trong khung hình"
            android:textColor="#536A61"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnHuyHieuChinh"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/fa_calibration_button"
            android:backgroundTint="@null"
            android:elevation="0dp"
            android:text="HỦY HIỆU CHỈNH"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
