<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hd_hero_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tên cử chỉ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtSoThuTuCuChi"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/hd_circle_mint"
            android:gravity="center"
            android:text="1"
            android:textColor="#218A68"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTenCuChi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quay trái"
                android:textColor="#103A2F"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMoTaCuChi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Quay đầu sang bên trái"
                android:textColor="#71847C"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtNhanCheDo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hd_circle_blue"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text="ĐIỀU HƯỚNG"
            android:textColor="#397E9D"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Khu vực nhân vật -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="235dp"
        android:layout_marginTop="10dp">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animationHuongDan"
            android:layout_width="215dp"
            android:layout_height="215dp"
            android:layout_gravity="center"
            android:contentDescription="Minh họa cử chỉ khuôn mặt"
            app:lottie_autoPlay="false"
            app:lottie_loop="true" />

    </FrameLayout>

    <!-- Hành động thực tế -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hd_action_strip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/hd_circle_mint"
            android:gravity="center"
            android:text="✓"
            android:textColor="#218A68"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hành động"
                android:textColor="#7A8983"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtHanhDongCuChi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chuyển đến mục trước"
                android:textColor="#123C30"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Gợi ý -->
    <TextView
        android:id="@+id/txtGoiYCuChi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Vuốt sang trái hoặc phải để xem cử chỉ khác"
        android:textColor="#82918B"
        android:textSize="11sp" />

</LinearLayout>