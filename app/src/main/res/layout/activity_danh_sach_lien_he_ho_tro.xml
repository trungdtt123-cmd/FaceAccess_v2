<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_man_hinh"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuayLaiDanhSachHoTro"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="←"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Liên hệ hỗ trợ"
                android:textColor="@color/chu_chinh"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <EditText
            android:id="@+id/edtTimKiemLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/nen_the"
            android:hint="Tìm theo tên hoặc số điện thoại"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/chu_chinh"
            android:textColorHint="@color/chu_phu" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnThemLienHeHoTro"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:backgroundTint="@color/xanh_chinh"
                android:text="+ THÊM LIÊN HỆ"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnXoaLienHeHoTro"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:backgroundTint="@color/do_trang_thai"
                android:text="XÓA LIÊN HỆ"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnHuyCheDoXoaLienHe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="HỦY CHỌN"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtTongLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tổng: 0 liên hệ"
            android:textColor="@color/chu_phu"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtDanhSachLienHeHoTroRong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:padding="24dp"
            android:text="Chưa có liên hệ hỗ trợ.\nNhấn “Thêm liên hệ” để bắt đầu."
            android:textColor="@color/chu_phu"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/khungDanhSachLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>