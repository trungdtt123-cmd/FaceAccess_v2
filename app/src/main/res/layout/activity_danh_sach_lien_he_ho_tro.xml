<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FBF8"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuayLaiDanhSachHoTro"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/fa_support_back_button"
                android:backgroundTint="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="#173D33"
                android:textSize="32sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Liên hệ hỗ trợ"
                android:textColor="#103A2F"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="FaceAccess"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_faceaccess_logo" />

        </LinearLayout>

        <EditText
            android:id="@+id/edtTimKiemLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/fa_support_input"
            android:drawableStart="@drawable/ic_support_search"
            android:drawablePadding="10dp"
            android:hint="Tìm tên hoặc số điện thoại"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#173D33"
            android:textColorHint="#7D8F88"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnThemLienHeHoTro"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/fa_support_button_primary"
                android:backgroundTint="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:text="+  Thêm liên hệ"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnXoaLienHeHoTro"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/fa_support_button_secondary"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_support_trash"
                android:drawablePadding="7dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:text="Xóa liên hệ"
                android:textAllCaps="false"
                android:textColor="#315248"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnHuyCheDoXoaLienHe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/fa_support_button_secondary"
            android:backgroundTint="@null"
            android:minHeight="0dp"
            android:text="Hủy chọn"
            android:textAllCaps="false"
            android:textColor="#315248"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtTongLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="0 liên hệ"
            android:textColor="#71847C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtDanhSachLienHeHoTroRong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:padding="20dp"
            android:text="Chưa có liên hệ hỗ trợ"
            android:textColor="#7D8F88"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/khungDanhSachLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
