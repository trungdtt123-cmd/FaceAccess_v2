<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/fa_settings_card" android:orientation="vertical" tools:ignore="HardcodedText" android:elevation="2dp">
    <LinearLayout android:id="@+id/mucDuLieu" android:layout_width="match_parent" android:layout_height="78dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="14dp">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="" android:src="@drawable/ic_settings_backup" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lưu &amp; khôi phục" android:textColor="@color/chu_chinh" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:text="Lưu, sao lưu hoặc đặt lại cấu hình" android:textColor="@color/chu_phu" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/muiTenDuLieu" android:layout_width="30dp" android:layout_height="42dp" android:gravity="center" android:text="›" android:textColor="#2A9D75" android:textSize="27sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/noiDungDuLieu" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="0dp" android:paddingEnd="16dp" android:paddingBottom="16dp" android:visibility="gone">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="10dp" android:background="#E7EFEB" />
        <Button android:id="@+id/btnLuuThayDoi" android:layout_width="match_parent" android:layout_height="48dp" android:text="LƯU THAY ĐỔI" android:textColor="@android:color/white" android:textStyle="bold" android:background="@drawable/fa_settings_button_primary" android:stateListAnimator="@null" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/btnTaiLenCauHinh" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="TẠO BẢN SAO" android:textColor="#31574B" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/fa_settings_button_soft" android:stateListAnimator="@null" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnTaiXuongCauHinh" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="KHÔI PHỤC" android:textColor="#31574B" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/fa_settings_button_soft" android:stateListAnimator="@null" />
        </LinearLayout>
        <TextView android:id="@+id/txtTrangThaiBanSao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Chưa có bản sao cấu hình" android:textColor="@color/chu_phu" android:textSize="12sp" />
        <Button android:id="@+id/btnDatLaiTatCa" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="ĐẶT LẠI TOÀN BỘ" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/fa_settings_button_danger" android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
