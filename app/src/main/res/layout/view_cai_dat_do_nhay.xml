<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/fa_settings_card" android:orientation="vertical" tools:ignore="HardcodedText" android:elevation="2dp">
    <LinearLayout android:id="@+id/mucDoNhay" android:layout_width="match_parent" android:layout_height="78dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="14dp">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="" android:src="@drawable/ic_settings_sensitivity" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Độ nhạy cử chỉ" android:textColor="@color/chu_chinh" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:text="Đầu, mắt và miệng" android:textColor="@color/chu_phu" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/muiTenDoNhay" android:layout_width="30dp" android:layout_height="42dp" android:gravity="center" android:text="›" android:textColor="#2A9D75" android:textSize="27sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/noiDungDoNhay" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="0dp" android:paddingEnd="16dp" android:paddingBottom="16dp" android:visibility="gone">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="10dp" android:background="#E7EFEB" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Độ nhạy càng cao thì cử chỉ càng dễ được nhận diện. Nên giữ mức Cân bằng nếu chưa cần tinh chỉnh." android:textColor="@color/chu_phu" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="CỬ CHỈ ĐẦU" android:textColor="@color/xanh_chinh" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quay trái" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtDoNhayQuayTrai" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="end" android:text="Cân bằng" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekDoNhayQuayTrai" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quay phải" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtDoNhayQuayPhai" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="end" android:text="Cân bằng" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekDoNhayQuayPhai" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ngẩng đầu" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtDoNhayNhinLen" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="end" android:text="Cân bằng" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekDoNhayNhinLen" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cúi đầu" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtDoNhayNhinXuong" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="end" android:text="Cân bằng" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekDoNhayNhinXuong" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nghiêng trái" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtDoNhayNghiengTrai" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="end" android:text="Cân bằng" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekDoNhayNghiengTrai" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nghiêng phải" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtDoNhayNghiengPhai" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="end" android:text="Cân bằng" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekDoNhayNghiengPhai" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="CỬ CHỈ KHUÔN MẶT" android:textColor="@color/xanh_chinh" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nhắm hai mắt" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtDoNhayNhamMat" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="end" android:text="Cân bằng" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekDoNhayNhamMat" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Há miệng" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtDoNhayMoMieng" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="end" android:text="Cân bằng" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekDoNhayMoMieng" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Há miệng 2 lần" android:textColor="@color/chu_chinh" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtDoNhayMoMiengHaiLan" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="end" android:text="Cân bằng" android:textColor="@color/xanh_chinh" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <SeekBar android:id="@+id/seekDoNhayMoMiengHaiLan" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="50" android:progressBackgroundTint="#DDE8E3" android:progressTint="#2A9D75" android:thumbTint="#2A9D75" />
        </LinearLayout>
        <Button android:id="@+id/btnDatLaiDoNhay" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="ĐẶT LẠI ĐỘ NHẠY" android:textColor="#31574B" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/fa_settings_button_soft" android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
