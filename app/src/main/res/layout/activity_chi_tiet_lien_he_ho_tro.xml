<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FBF8"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuayLaiChiTietLienHe"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/fa_support_back_button"
                android:backgroundTint="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="#173D33"
                android:textSize="32sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Chi tiết liên hệ"
                android:textColor="#103A2F"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="FaceAccess"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_faceaccess_logo" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/imgAvatarChiTietLienHeHoTro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fa_support_avatar"
                android:clipToOutline="true"
                android:contentDescription="Ảnh đại diện liên hệ"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtAvatarChiTietLienHeHoTro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fa_support_avatar"
                android:gravity="center"
                android:text="?"
                android:textColor="@android:color/white"
                android:textSize="42sp"
                android:textStyle="bold" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGoiLienHeHoTro"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/fa_support_button_primary"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_support_phone"
                android:drawablePadding="8dp"
                android:drawableTint="@android:color/white"
                android:gravity="center"
                android:minHeight="0dp"
                android:text="Gọi"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnChonAnhLienHeHoTro"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/fa_support_button_secondary"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_support_image"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:text="Chọn ảnh"
                android:textAllCaps="false"
                android:textColor="#315248"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/fa_support_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên"
                android:textColor="#36564B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTenChiTietLienHeHoTro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fa_support_input"
                android:hint="Tên liên hệ"
                android:inputType="textPersonName"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#173D33"
                android:textColorHint="#8A9A94"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Số điện thoại"
                android:textColor="#36564B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtSoDienThoaiChiTietLienHeHoTro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fa_support_input"
                android:hint="Số điện thoại"
                android:inputType="phone"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#173D33"
                android:textColorHint="#8A9A94"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mô tả"
                android:textColor="#36564B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtMoTaChiTietLienHeHoTro"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fa_support_input"
                android:gravity="top|start"
                android:hint="Mô tả"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="15dp"
                android:textColor="#173D33"
                android:textColorHint="#8A9A94"
                android:textSize="15sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnCapNhatLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/fa_support_button_primary"
            android:backgroundTint="@null"
            android:gravity="center"
            android:minHeight="0dp"
            android:text="Cập nhật"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnXoaMotLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/fa_support_button_secondary"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_support_trash"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:minHeight="0dp"
            android:text="Xóa liên hệ"
            android:textAllCaps="false"
            android:textColor="#315248"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
