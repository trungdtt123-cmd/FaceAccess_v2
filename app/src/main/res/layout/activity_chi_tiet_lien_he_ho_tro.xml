<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_man_hinh"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuayLaiChiTietLienHe"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="←"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Chi tiết liên hệ"
                android:textColor="@color/chu_chinh"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- AVATAR: ẢNH THẬT HOẶC CHỮ CÁI ĐẦU -->

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp">

            <ImageView
                android:id="@+id/imgAvatarChiTietLienHeHoTro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/nen_avatar_lien_he"
                android:clipToOutline="true"
                android:contentDescription="Ảnh đại diện liên hệ hỗ trợ"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtAvatarChiTietLienHeHoTro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/nen_avatar_lien_he"
                android:gravity="center"
                android:text="?"
                android:textColor="@android:color/white"
                android:textSize="42sp"
                android:textStyle="bold" />

        </FrameLayout>


        <!-- HÀNH ĐỘNG NHANH -->


        <!-- TÊN -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnChonAnhLienHeHoTro"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/xanh_chinh"
                android:text="CHỌN ẢNH"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGoiLienHeHoTro"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/xanh_chinh"
                android:text="GỌI"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Tên"
            android:textColor="@color/chu_chinh"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTenChiTietLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/nen_the"
            android:hint="Tên liên hệ"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/chu_chinh"
            android:textColorHint="@color/chu_phu" />


        <!-- SỐ ĐIỆN THOẠI -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Số điện thoại"
            android:textColor="@color/chu_chinh"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtSoDienThoaiChiTietLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/nen_the"
            android:hint="Số điện thoại"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/chu_chinh"
            android:textColorHint="@color/chu_phu" />


        <!-- MÔ TẢ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mô tả"
            android:textColor="@color/chu_chinh"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtMoTaChiTietLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/nen_the"
            android:gravity="top|start"
            android:hint="Thêm mô tả cho liên hệ"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="16dp"
            android:textColor="@color/chu_chinh"
            android:textColorHint="@color/chu_phu" />


        <!-- CẬP NHẬT -->

        <Button
            android:id="@+id/btnCapNhatLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/xanh_chinh"
            android:text="CẬP NHẬT"
            android:textColor="@android:color/white"
            android:textStyle="bold" />


        <!-- XÓA -->

        <Button
            android:id="@+id/btnXoaMotLienHeHoTro"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/do_trang_thai"
            android:text="XÓA LIÊN HỆ"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>