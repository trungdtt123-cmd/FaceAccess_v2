<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FBF8"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <ScrollView
        android:id="@+id/noiDungCuonCaiDat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/khungHeaderCaiDat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Logo FaceAccess"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_faceaccess_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FaceAccess"
                        android:textColor="#073E32"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Điều khiển bằng khuôn mặt"
                        android:textColor="#6D8179"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/hd_circle_blue"
                    android:gravity="center"
                    android:text="AI"
                    android:textColor="#2E7695"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Tiêu đề trang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnQuayLai"
                    android:layout_width="38dp"
                    android:layout_height="46dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:text="‹"
                    android:textColor="#173A30"
                    android:textSize="32sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cài đặt"
                        android:textColor="#103A2F"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Chọn mục cần điều chỉnh, chỉ mở khi bạn cần."
                        android:textColor="#6D8179"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtTrangThaiLuu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fa_settings_status_chip"
                    android:paddingStart="11dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="7dp"
                    android:text="Đã lưu"
                    android:textColor="#218A68"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <include layout="@layout/view_cai_dat_hieu_chinh" />
            <include layout="@layout/view_cai_dat_do_nhay" />
            <include layout="@layout/view_cai_dat_cu_chi_toan_cuc" />
            <include layout="@layout/view_cai_dat_phan_hoi" />
            <include layout="@layout/view_cai_dat_du_lieu" />
            <include layout="@layout/view_cai_dat_he_thong" />

        </LinearLayout>

    </ScrollView>

    <!-- Menu dưới, đồng bộ Trang chủ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="@drawable/fa_home_nav_surface"
        android:elevation="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingTop="7dp"
        android:paddingEnd="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/navTrangChu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:drawableTop="@drawable/ic_nav_home"
            android:drawablePadding="3dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Trang chủ"
            android:textColor="#7D8F88"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navHuongDan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:drawableTop="@drawable/ic_nav_guide"
            android:drawablePadding="3dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Hướng dẫn"
            android:textColor="#7D8F88"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navHieuChinh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:drawableTop="@drawable/ic_nav_calibrate"
            android:drawablePadding="3dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Hiệu chỉnh"
            android:textColor="#7D8F88"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navCaiDat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:drawableTop="@drawable/ic_nav_settings"
            android:drawablePadding="3dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Cài đặt"
            android:textColor="#218A68"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
