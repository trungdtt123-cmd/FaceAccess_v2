<data-extraction-rules>
    <cloud-backup>
        <!-- Không sao lưu dữ liệu riêng tư/cấu hình của FaceAccess lên cloud. -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>

    <device-transfer>
        <!-- Chặn sao chép tự động cùng các miền dữ liệu khi chuyển thiết bị. -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
