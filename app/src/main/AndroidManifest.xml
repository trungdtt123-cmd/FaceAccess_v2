<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================================================= -->
    <!-- QUYỀN CAMERA -->
    <!-- ================================================= -->

    <uses-permission android:name="android.permission.CAMERA" />


    <!-- ================================================= -->
    <!-- QUYỀN FOREGROUND SERVICE -->
    <!-- ================================================= -->

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />


    <!-- ================================================= -->
    <!-- PHẦN CỨNG CAMERA -->
    <!-- ================================================= -->

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />


    <!-- ================================================= -->
    <!-- APPLICATION -->
    <!-- ================================================= -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FaceAccess_v2">


        <!-- ================================================= -->
        <!-- MÀN HÌNH CHÍNH -->
        <!-- ================================================= -->

        <activity
            android:name=".ManHinhChinhActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- ================================================= -->
        <!-- QUẢN LÝ LIÊN HỆ HỖ TRỢ -->
        <!-- ================================================= -->

        <activity
            android:name=".dieuphoi.hotro.DanhSachLienHeHoTroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".dieuphoi.hotro.ThemLienHeHoTroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".dieuphoi.hotro.ChiTietLienHeHoTroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ================================================= -->
        <!-- CĂN CHỈNH ẢNH ĐẠI DIỆN -->
        <!-- ================================================= -->

        <!--
            Activity riêng của FaceAccess kế thừa UCropActivity.
            Có UI tối đồng bộ và nút XÁC NHẬN ẢNH rõ ràng.
        -->
        <activity
            android:name=".dieuphoi.hotro.CanChinhAnhLienHeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />


        <!-- ================================================= -->
        <!-- ACCESSIBILITY SERVICE -->
        <!-- ================================================= -->

        <service
            android:name=".truycap.DichVuTruyCapFaceAccess"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.accessibilityservice.AccessibilityService" />

            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/cau_hinh_truy_cap" />

        </service>


        <!-- ================================================= -->
        <!-- FOREGROUND TRACKING SERVICE -->
        <!-- ================================================= -->

        <service
            android:name=".dichvu.DichVuTheoDoiFaceAccess"
            android:exported="false"
            android:foregroundServiceType="camera" />


    </application>

</manifest>